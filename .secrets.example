# Copy to .secrets (already gitignored) and fill in real values to run
# workflows locally via act. See .actrc for the runner image pin.
#
# Usage: act <event> -j <job> -W .github/workflows/<file>.yml
#   (--secret-file .secrets is picked up automatically if the file is
#   named .secrets at the repo root)
#
# Where each value comes from: Settings > Secrets and variables > Actions,
# in the real GitHub repo (blanketops/environments) — these are the same
# secrets CI uses, not new ones to create.

# BlanketOps-Environments GitHub App — used for checkout/push auth and
# private-module git config across almost every workflow (ci.yml,
# code-docs.yml, create-release.yml, finalize-release.yml,
# release-assets.yml, security.yml). Without these, every job that starts
# with "Generate GitHub App token" fails immediately.
APP_ID=
APP_PRIVATE_KEY=

# Signs the changelog/merge commits and release tag so they show as
# "Verified" on GitHub. Needed by code-docs.yml, finalize-release.yml,
# release.yml.
GPG_PRIVATE_KEY=
GPG_PASSPHRASE=

# act provides a working GITHUB_TOKEN automatically for most local runs,
# but it won't have real push/release permissions against the actual
# GitHub repo — steps that call `gh` or push tags/releases will still hit
# the real API with whatever scope this token has. Only set this if you
# specifically need a token with more than act's default.
# GITHUB_TOKEN=
