{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(go tool cover *)",
      "Bash(go list *)",
      "Bash(go doc *)",
      "Bash(gofmt -l *)",
      "Bash(golangci-lint run *)",
      "Bash(actionlint *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git rev-list *)",
      "Bash(git merge-base *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)"
    ],
    "deny": [
      "Read(./.secrets)",
      "Read(./.vars)",
      "Read(./.input)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(./**/*.crt)",
      "Edit(./.secrets)",
      "Edit(./.vars)",
      "Edit(./.input)",
      "Edit(./.env)",
      "Edit(./.env.*)"
    ]
  }
}
